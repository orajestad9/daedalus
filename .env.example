# Copy this file to .env for local development, then replace every
# change_me_* value. Never commit .env or real secrets.

# Docker Compose Postgres settings.
DAEDALUS_POSTGRES_USER=change_me_daedalus_user
DAEDALUS_POSTGRES_PASSWORD=change_me_daedalus_password
DAEDALUS_POSTGRES_DB=change_me_daedalus_db
DAEDALUS_POSTGRES_HOST_PORT=5433
DAEDALUS_POSTGRES_CONTAINER_NAME=daedalus-postgres-local
DAEDALUS_POSTGRES_VOLUME_NAME=daedalus_postgres_data

# Python CLI/Postgres client settings.
# Keep these aligned with the Docker Compose values above.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=change_me_daedalus_db
POSTGRES_USER=change_me_daedalus_user
POSTGRES_PASSWORD=change_me_daedalus_password
